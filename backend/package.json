{
  "name": "crowdpay-backend",
  "version": "1.0.0",
  "description": "CrowdPay backend — campaign logic, Stellar wallet management, Horizon listener",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src/ db/ scripts/",
    "lint:fix": "eslint src/ db/ scripts/ --fix",
    "format:check": "prettier --check src/ db/ scripts/",
    "test": "node scripts/run-tests.js",
    "migrate": "node db/migrate.js up",
    "migrate:status": "node db/migrate.js status",
    "migrate:down": "node db/migrate.js down",
    "migrate:fresh": "psql $DATABASE_URL -f db/schema.sql && node db/migrate.js up --bootstrap-schema && node db/verify-schema-convergence.js",
    "validate-milestones": "node scripts/validate-milestone-percentages.js",
    "deploy-contracts": "node src/scripts/deployContracts.js",
    "rotate-wallet-secrets": "node src/scripts/rotateWalletSecrets.js",
    "rotate-wallet-secrets:dry-run": "node src/scripts/rotateWalletSecrets.js --dry-run",
    "rotate-wallet-secrets:confirm": "node src/scripts/rotateWalletSecrets.js --confirm"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.410.0",
    "@sentry/node": "^10.68.0",
    "@stellar/stellar-sdk": "^12.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.0.1",
    "file-type": "^16.5.4",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.1.0",
    "husky": "^9.1.7",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@noble/hashes": "^1.3.1",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.9",
    "proxyquire": "^2.1.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "toml": "^4.2.0",
    "brace-expansion": "5.0.9"
  }
}
